{
  "name": "my-platform",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @my-platform/db run generate",
    "db:push": "pnpm db:migrate",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "postinstall": "pnpm run db:generate",
    "livekit:up": "docker compose -f infra/docker/docker-compose.livekit.yml up -d",
    "livekit:down": "docker compose -f infra/docker/docker-compose.livekit.yml down",
    "dev:legacy": "pnpm --filter api dev",
    "server:dev": "cd apps/server && go run ./cmd/api",
    "server:test": "cd apps/server && go test ./...",
    "db:migrate": "cd apps/server && go run ./cmd/api -migrate-only",
    "agent:dev": "pnpm --filter agent dev",
    "agent:test": "pnpm --filter agent test",
    "worker:dev": "cd apps/server && go run ./cmd/worker",
    "dev:all": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "prisma": "6.19.2",
      "@prisma/client": "6.19.2"
    }
  }
}
