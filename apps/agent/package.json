{
  "name": "agent",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "eval": "node --import tsx src/evals/run.ts",
    "eval:personas": "node --import tsx src/evals/personas.ts",
    "eval:companion": "node --import tsx src/evals/companion.ts",
    "eval:private-chat": "node --import tsx src/evals/private-chat.ts",
    "check:companion-release": "node --import tsx src/evals/check-release.ts",
    "checkpoint:migrate": "node --import tsx src/companion/migrate.ts",
    "dev:livekit": "tsx watch src/room-main.ts dev",
    "start:livekit": "node dist/room-main.js start"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openai": "^1.8.0",
    "@livekit/agents": "^1.9.5",
    "@livekit/rtc-node": "^1.2.1",
    "@openai/agents": "^0.18.0",
    "dotenv": "^17.2.3",
    "livekit-server-sdk": "^2.13.1",
    "openai": "^7.27.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
