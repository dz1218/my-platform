{
  "name": "agent",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "eval": "node --import tsx src/evals/run.ts",
    "dev:livekit": "tsx watch src/legacy-livekit.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "dotenv": "^17.2.3",
    "livekit-server-sdk": "^2.13.1",
    "openai": "^7.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
