AGENT_HOST=127.0.0.1
AGENT_PORT=8081
AGENT_TOKEN=replace-with-the-same-random-secret-in-server-env
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Enable only if the configured provider supports JSON Schema structured output.
LLM_STRUCTURED_OUTPUT=false

# Enable after applying Go migrations and running checkpoint:migrate.
COMPANION_RUNTIME=legacy
COMPANION_ROLLOUT_PERCENT=100
# Production langgraph rollout requires a completed, version-matched report.
COMPANION_RELEASE_REPORT=
AGENT_SERVER_URL=http://127.0.0.1:8080
# Runtime role: only the companion_runtime schema, no business-table grants.
AGENT_DATABASE_URL=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# Room assistant: local development also reads LIVEKIT_* from ../server/.env.
# Production room-agent container must receive the same LiveKit configuration as Go.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsec
# LIVEKIT_AGENT_NAME=room-assistant
ROOM_API_URL=http://127.0.0.1:8080
ROOM_AGENT_PORT=8082
