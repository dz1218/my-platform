COMPANION_API_URL=http://127.0.0.1:8080
# Room, matches and chat WebSockets connect directly to this API; http/https becomes ws/wss.
# If the API URL is internal, set its public Go WebSocket origin (no path).
# This is server-only and is not the LiveKit media URL.
# COMPANION_WS_URL=wss://api.example.com
# Optional single client-IP header overwritten by your trusted ingress.
# Also trust the Next server's peer CIDR via TRUSTED_PROXY_CIDRS on Go.
# Leave unset until ingress behavior is verified; never blindly forward browser XFF.
# LIVE_TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Public canonical website origin. Update when changing the frontend domain.
SITE_URL=https://xingyun7.space
