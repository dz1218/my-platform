SERVER_ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:3011
COOKIE_SECURE=false
AGENT_URL=http://127.0.0.1:8081
AGENT_TOKEN=replace-with-the-same-random-secret-in-agent-env
BEHAVIOR_CONFIG=config/behavior.json

# Optional LiveKit rooms. Omit all three values to disable room endpoints.
# Local Docker defaults below. Keep production Cloud, Redis and PostgreSQL separate.
# Sharing a Cloud project shares its rooms with every backend using that project.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsec
LIVEKIT_AGENT_NAME=room-assistant
# Optional server-only address; LIVEKIT_URL is returned to browsers.
# LIVEKIT_INTERNAL_URL=http://livekit:7880
# Optional per-minute live room limits (unknown keys/nonpositive values fail startup).
# LIVE_ROOM_LIMITS={"join_account":30,"join_guest":120,"voice_write":30,"voice_read":60,"socket_account":60,"socket_guest":120,"connections_account":10,"connections_guest":100,"mutation_account":20,"ip_total":1200}
# Enable only in a separate rollout after all older API/maintenance writers stop.
# Backfill is automatic and fails closed; keep all writers on the same mode.
LIVE_ROOM_SCOPED_LOCKS=false
# Explicit trusted ingress/Next.js peer CIDRs only; empty ignores forwarded IPs.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# In LiveKit Cloud, configure a webhook to:
# https://<public-go-api-host>/api/v1/livekit/webhook
# Select LIVEKIT_API_KEY as its signing key. The Go API verifies the raw body.
# Webhooks drive timely updates; persisted per-room checks repair missed events.
# Configure the webhook even with recovery checks to avoid delayed offline detection.
# Local development against Cloud needs a public HTTPS tunnel to the Go API.
# Local Docker LiveKit already points to host.docker.internal:8080.

# Aliyun SMS (server only). Use an approved sign and verification template.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_RESET_TEMPLATE_CODE=100003
SMS_TEMPLATE_CODE=
SMS_CODE_PARAMETER=code
# Optional room assistant credential; same value in the room Worker.
# Defaults to a purpose-specific HMAC derived from AGENT_TOKEN.
# ROOM_AGENT_TOKEN=replace-with-a-dedicated-random-secret-of-at-least-32-characters
