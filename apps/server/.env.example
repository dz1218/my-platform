SERVER_ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:3011
COOKIE_SECURE=false
AGENT_URL=http://127.0.0.1:8081
AGENT_TOKEN=replace-with-the-same-random-secret-in-agent-env
BEHAVIOR_CONFIG=config/behavior.json

# Optional LiveKit rooms. Omit all three values to disable room endpoints.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsec
LIVEKIT_AGENT_NAME=room-assistant
# Optional server-only address; LIVEKIT_URL is returned to browsers.
# LIVEKIT_INTERNAL_URL=http://livekit:7880
# In LiveKit Cloud, configure a webhook to:
# https://<public-go-api-host>/api/v1/livekit/webhook
# Select LIVEKIT_API_KEY as its signing key. The Go API verifies the raw body.
# Automatic room cleanup requires this webhook; there is no periodic room sweep.
# Local development against Cloud needs a public HTTPS tunnel to the Go API.
# Local Docker LiveKit already points to host.docker.internal:8080.

# Aliyun SMS (server only). Use an approved sign and verification template.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_PARAMETER=code
